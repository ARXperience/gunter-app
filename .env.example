# =============================================
# Gunter — Plantilla de Variables de Entorno
# =============================================
# Copia este archivo a `.env` y rellena los valores.
# El archivo `.env` está en .gitignore — NUNCA lo subas a GitHub.
# Para deploy en hosting (Koyeb, Render, Oracle), copia estos valores
# en el panel de "Environment Variables" del servicio.
# =============================================


# ────────────────────────────────────────────
# OBLIGATORIAS (sin esto, el server no arranca útil)
# ────────────────────────────────────────────

# OpenAI API key — usada por: /api/chat, /api/transcribe, /api/tts,
# /api/embeddings, /api/premium-intel, /api/commitments, /api/style-mirror
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-PEGA_AQUI_TU_KEY_REAL


# ────────────────────────────────────────────
# OPCIONALES (cada una desactiva un grupo de funciones si falta)
# ────────────────────────────────────────────

# Gemini API key — usada por: /api/gemini-text, /api/gemini-image, /api/document-extract
# Si falta: las slides + smartDocuments (recibos/facturas) no funcionarán.
# Obtener en: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Google OAuth Client ID — usado por: integración Google Calendar
# Si falta: la pestaña Calendar no podrá conectarse.
# Crear en: https://console.cloud.google.com/apis/credentials
# IMPORTANTE: en Authorized JavaScript origins añade tu dominio de producción.
GOOGLE_CLIENT_ID=


# ────────────────────────────────────────────
# CONFIGURACIÓN DEL SERVER
# ────────────────────────────────────────────

# Puerto HTTP. En hosting (Koyeb, Render) suele venir definido por el provider
# como variable inyectada — no la sobreescribas.
PORT=3001

# CORS allowlist — coma-separada. En desarrollo déjalo vacío (CORS abierto a *).
# En producción Android/PWA, añade los orígenes que la app va a usar:
#   - Tu dominio de producción HTTPS
#   - 'null' si vas a usar WebView puro (poco recomendado)
# Ejemplo:
# ALLOWED_ORIGINS=https://gunter.tudominio.com,https://staging.gunter.app
ALLOWED_ORIGINS=


# ────────────────────────────────────────────
# MODELOS (avanzado — solo cambia si sabes lo que haces)
# ────────────────────────────────────────────

# Modelo de chat (afecta calidad y costo)
CHAT_MODEL=gpt-4o-mini

# Modelo de transcripción (Whisper)
WHISPER_MODEL=whisper-1


# ────────────────────────────────────────────
# WHATSAPP (Baileys)
# ────────────────────────────────────────────

# No requiere API key. Las credenciales se generan al escanear el QR.
# Las credenciales viven en `whatsapp-data/session/` — necesita VOLUMEN
# PERSISTENTE en el hosting o la sesión se pierde en cada deploy/restart.
#
# Hostings que soportan volumen persistente gratis:
#   - Koyeb (free tier)
#   - Oracle Cloud (always free)
#
# Hostings que NO (sesión se pierde):
#   - Render free, Vercel, Glitch, Replit


# ────────────────────────────────────────────
# DEBUG / DEV ONLY
# ────────────────────────────────────────────

# Verbose logs (no usar en producción)
# DEBUG=gunter:*
