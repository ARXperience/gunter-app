# Servidor
NODE_ENV=production
PORT=3001
GUNTER_REPLICAS=1
ALLOWED_ORIGINS=https://gunter.example.com
AUTH_COOKIE_SECURE=true
# Establecer en true solo cuando HTTPS termina en un proxy inverso confiable.
TRUST_PROXY=false

# Configura al menos un proveedor de IA.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Opcional: calendario y notificaciones Web Push entre varias instancias.
GOOGLE_CLIENT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com

# Opcional: Firebase Cloud Messaging HTTP v1 (JSON de cuenta de servicio en un secreto del servidor).
FCM_SERVICE_ACCOUNT_JSON=
# Opcional: Apple Push Notification service (clave .p8 en un secreto del servidor; nunca en la app móvil).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.gunter.mobile
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=production
# Recomendado en producción: clave base64url de 32 bytes para tokens móviles cifrados en reposo.
MOBILE_PUSH_ENCRYPTION_KEY=

# Opcional: teléfono de la cuenta propietaria para el puente de WhatsApp.
OWNER_PHONE=

# TTS local Supertonic 3 M1 (ruta absoluta del modelo fuera del repositorio).
# Alternativa: data/local-tts.json, privado e ignorado por Git.
GUNTER_LOCAL_TTS_MODEL_DIR=
